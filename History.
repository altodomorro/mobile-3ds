label_email = tk.Label(
    janela,
    text="E-mail:"
)
label_email.pack()

entrada_email = tk.Entry(
    janela,
    width=40
)
entrada_email.pack(pady=5)


# Telefone
label_telefone = tk.Label(
    janela,
    text="Telefone:"
)
label_telefone.pack()

entrada_telefone = tk.Entry(
    janela,
    width=40
)
entrada_telefone.pack(pady=5)


# -----------------------------
# Botões
# -----------------------------

frame_botoes = tk.Frame(janela)
frame_botoes.pack(pady=20)


botao_salvar = tk.Button(
    frame_botoes,
    text="Salvar",
    width=14,
    command=salvar_cliente
)
botao_salvar.grid(
    row=0,
    column=0,
    padx=5,
    pady=5
)


botao_limpar = tk.Button(
    frame_botoes,
    text="Limpar",
    width=14,
    command=limpar_formulario
)
botao_limpar.grid(
    row=0,
    column=1,
    padx=5,
    pady=5
)


botao_visualizar = tk.Button(
    frame_botoes,
    text="Visualizar Clientes",
    width=30,
    command=visualizar_clientes
)
botao_visualizar.grid(
    row=1,
    column=0,
    columnspan=2,
    padx=5,
    pady=10
)


# -----------------------------
# Inicia o programa
# -----------------------------

janela.mainloop()

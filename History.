import tkinter as tk
from tkinter import messagebox, ttk
import sqlite3


# -----------------------------
# Banco de dados
# -----------------------------

def criar_banco():
    conexao = sqlite3.connect("clientes.db")
    cursor = conexao.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS clientes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            email TEXT NOT NULL,
            telefone TEXT NOT NULL
        )
    """)

    conexao.commit()
    conexao.close()


# -----------------------------
# Função para salvar cliente
# -----------------------------

def salvar_cliente():
    nome = entrada_nome.get().strip()
    email = entrada_email.get().strip()
    telefone = entrada_telefone.get().strip()

    # Validação dos campos
    if not nome or not email or not telefone:
        messagebox.showwarning(
            "Atenção",
            "Preencha todos os campos antes de salvar."
        )
        return

    try:
        conexao = sqlite3.connect("clientes.db")
        cursor = conexao.cursor()

        cursor.execute("""
            INSERT INTO clientes (nome, email, telefone)
            VALUES (?, ?, ?)
        """, (nome, email, telefone))

        conexao.commit()
        conexao.close()

        messagebox.showinfo(
            "Sucesso",
            "Cliente cadastrado com sucesso!"
        )

        limpar_formulario()

    except sqlite3.Error as erro:
        messagebox.showerror(
            "Erro",
            f"Não foi possível salvar o cliente.\n{erro}"
        )


# -----------------------------
# Função para limpar formulário
# -----------------------------

def limpar_formulario():
    entrada_nome.delete(0, tk.END)
    entrada_email.delete(0, tk.END)
    entrada_telefone.delete(0, tk.END)

    entrada_nome.focus()


# -----------------------------
# Função para visualizar clientes
# -----------------------------

def visualizar_clientes():
    janela_clientes = tk.Toplevel(janela)
    janela_clientes.title("Clientes Cadastrados")
    janela_clientes.geometry("700x400")
    janela_clientes.resizable(True, True)

    # Título da janela
    titulo_clientes = tk.Label(
        janela_clientes,
        text="Clientes Cadastrados",
        font=("Arial", 16, "bold")
    )
    titulo_clientes.pack(pady=15)

    # Frame da tabela
    frame_tabela = tk.Frame(janela_clientes)
    frame_tabela.pack(
        fill="both",
        expand=True,
        padx=20,
        pady=10
    )

    # Criação da tabela
    tabela = ttk.Treeview(
        frame_tabela,
        columns=("id", "nome", "email", "telefone"),
        show="headings"
    )

    # Cabeçalhos
    tabela.heading("id", text="ID")
    tabela.heading("nome", text="Nome")
    tabela.heading("email", text="E-mail")
    tabela.heading("telefone", text="Telefone")

    # Largura das colunas
    tabela.column("id", width=50, anchor="center")
    tabela.column("nome", width=180)
    tabela.column("email", width=220)
    tabela.column("telefone", width=130)

    # Barra de rolagem
    scrollbar = ttk.Scrollbar(
        frame_tabela,
        orient="vertical",
        command=tabela.yview
    )

    tabela.configure(yscrollcommand=scrollbar.set)

    tabela.pack(side="left", fill="both", expand=True)
    scrollbar.pack(side="right", fill="y")

    # Buscar clientes no banco
    try:
        conexao = sqlite3.connect("clientes.db")
        cursor = conexao.cursor()

        cursor.execute("""
            SELECT id, nome, email, telefone
            FROM clientes
            ORDER BY id
        """)

        clientes = cursor.fetchall()

        conexao.close()

        # Inserir os clientes na tabela
        for cliente in clientes:
            tabela.insert("", tk.END, values=cliente)

        # Mensagem caso não existam clientes
        if not clientes:
            messagebox.showinfo(
                "Informação",
                "Não existem clientes cadastrados.",
                parent=janela_clientes
            )

    except sqlite3.Error as erro:
        messagebox.showerror(
            "Erro",
            f"Não foi possível consultar os clientes.\n{erro}",
            parent=janela_clientes
        )


# -----------------------------
# Inicialização do banco
# -----------------------------

criar_banco()


# -----------------------------
# Interface gráfica
# -----------------------------

janela = tk.Tk()
janela.title("Cadastro de Clientes")
janela.geometry("450x400")
janela.resizable(False, False)


# Título
titulo = tk.Label(
    janela,
    text="Cadastro de Clientes",
    font=("Arial", 16, "bold")
)
titulo.pack(pady=20)


